<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ротация троек</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #0b1220;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .wrapper {
      width: 520px;
      padding: 24px;
      border-radius: 16px;
      background: rgba(255,255,255,0.06);
      box-shadow: 0 10px 40px rgba(0,0,0,0.4);
    }

    h1 {
      font-size: 18px;
      margin: 0 0 16px;
      opacity: 0.9;
    }

    .queue {
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      overflow: hidden;
      height: 280px;
    }

    .group {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 16px;
      border-radius: 14px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      transition: transform 600ms ease, opacity 600ms ease;
    }

    .group span {
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .group.active {
      background: rgba(0, 170, 255, 0.22);
      border-color: rgba(0, 170, 255, 0.45);
      box-shadow: 0 8px 18px rgba(0,170,255,0.15);
    }

    .controls {
      margin-top: 18px;
      display: flex;
      gap: 10px;
    }

    button {
      flex: 1;
      padding: 12px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      font-weight: 700;
      background: rgba(255,255,255,0.12);
      color: white;
      transition: 0.2s;
    }

    button:hover {
      background: rgba(255,255,255,0.18);
    }

    button.primary {
      background: rgba(0,170,255,0.75);
    }

    button.primary:hover {
      background: rgba(0,170,255,0.9);
    }

    .hint {
      margin-top: 12px;
      font-size: 13px;
      opacity: 0.7;
      line-height: 1.4;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <h1>Ротация групп по 3 (первая уходит в конец)</h1>

    <div class="queue" id="queue"></div>

    <div class="controls">
      <button id="prev">◀ Назад</button>
      <button class="primary" id="toggle">⏸ Пауза</button>
      <button id="next">Вперёд ▶</button>
    </div>

    <div class="hint">
      Каждые 1.2 сек показывается следующая тройка.  
      После показа первая тройка уходит в конец очереди.
    </div>
  </div>

  <script>
    // Генерим группы: [30-29-28], [27-26-25], ... [3-2-1]
    function buildGroups() {
      const groups = [];
      for (let i = 30; i >= 1; i -= 3) {
        groups.push([i, i - 1, i - 2]);
      }
      return groups;
    }

    let groups = buildGroups();
    const queueEl = document.getElementById("queue");

    let timer = null;
    let isPlaying = true
